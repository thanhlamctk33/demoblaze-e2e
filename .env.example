# Copy to .env and adjust. Every value is optional.

# Target environment from src/config/environments.ts (default: prod)
TEST_ENV=prod
# Direct overrides (take precedence over TEST_ENV)
# BASE_URL=https://www.demoblaze.com
# API_URL=https://api.demoblaze.com

# Run headed locally: HEADLESS=false
HEADLESS=true

# Optional pre-existing account. Leave empty to auto-provision a fresh user per worker (recommended).
TEST_USERNAME=
TEST_PASSWORD=

# Timeouts (ms)
TEST_TIMEOUT=60000
EXPECT_TIMEOUT=10000
ACTION_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
DIALOG_TIMEOUT=10000

# Performance budgets (ms) for tests/perf
PERF_PAGE_LOAD_MS=5000
PERF_PRODUCTS_RENDERED_MS=6000
PERF_API_RESPONSE_MS=2000

# Optional: enables the AI triage section in scripts/summarize-results.mjs
# ANTHROPIC_API_KEY=
# AI_TRIAGE_MODEL=claude-sonnet-5-5
